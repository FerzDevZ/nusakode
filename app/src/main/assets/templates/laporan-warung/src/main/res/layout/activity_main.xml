<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/teks_ringkasan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/judul_ringkasan"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/input_keterangan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/petunjuk_keterangan"
        android:inputType="textCapSentences"
        android:maxLines="1" />

    <EditText
        android:id="@+id/input_jumlah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/petunjuk_jumlah"
        android:inputType="number"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tombol_masuk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tombol_masuk" />

        <Button
            android:id="@+id/tombol_keluar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/tombol_keluar" />
    </LinearLayout>

    <TextView
        android:id="@+id/teks_kosong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/kosong" />

    <ListView
        android:id="@+id/daftar_catatan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
