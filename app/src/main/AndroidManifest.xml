<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dipakai hanya untuk membuka pemasang APK setelah build sukses. -->
    <!-- AI memakai endpoint + kunci milik pengguna sendiri. Tanpa setelan AI, aplikasi tetap 100% offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Gambar untuk AI.
        Foto dipilih lewat Photo Picker sistem, jadi TIDAK butuh izin apa pun di Android 11+
        (dan Android 13+ malah tidak menampilkan dialog izin sama sekali). Dua izin di bawah hanya
        jaring pengaman untuk perangkat lama/rom yang tidak punya Photo Picker.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        SENGAJA TIDAK ADA MANAGE_EXTERNAL_STORAGE.
        Izin itu membuat Android 13+ menaruh aplikasi di "Setelan terbatas" dan Play Protect
        menampilkan "aplikasi berbahaya" saat dipasang dari luar Play Store — persis keluhan
        "tidak bisa dipasang". Folder projek di luar sandbox tetap bisa dipakai lewat SAF
        (Ekspor/Impor zip dan pemilih folder), jadi izin itu tidak memberi kemampuan baru.
    -->

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.KodeNusa">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.berkas"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
